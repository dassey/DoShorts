# DoShorts runs with no configuration at all: each user picks their own AI in
# the app (Ollama, LM Studio, or their own provider key), and those requests go
# from their browser straight to the provider. Everything below is optional.

# --- Built-in AI (optional) ---------------------------------------------------
# Offer an AI that works without setup. Users get 2 free runs per tool, then
# sign in with Google. Pick ONE of:
#
# a) Any OpenAI-compatible endpoint, including a local one:
# DOSHORTS_BASE_URL=http://localhost:11434/v1
# DOSHORTS_MODEL=
# DOSHORTS_API_KEY=
#
# b) Claude:
# ANTHROPIC_API_KEY=
# DOSHORTS_MODEL=claude-opus-5-5
# DOSHORTS_EFFORT=low          # low | medium | high
# DOSHORTS_WEB_SEARCH=0        # turn off web search in Trending Topics

# --- Google sign-in (only needed with a built-in AI) ----------------------------
# AUTH_SECRET=                 # npx auth secret
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=          # redirect URI: https://YOUR_DOMAIN/api/auth/callback/google

# --- YouTube data (optional) --------------------------------------------------
# YouTube Data API v3 key: adds view counts and length to the Short Analyzer and
# this week's most-viewed Shorts to Trending Topics.
# YOUTUBE_API_KEY=
